class DownloadPart extends Thread {
    String partName;

    DownloadPart(String name) {
        partName = name;
    }

    public void run() {
        try {
            System.out.println(partName + " downloading...");
            Thread.sleep(1000);      // simulate download time
            System.out.println(partName + " completed.");
        } catch (Exception e) {
            System.out.println(e);
        }
    }
}

public class FileDownloadSimulation {
    public static void main(String[] args) {
        DownloadPart t1 = new DownloadPart("Part 1");
        DownloadPart t2 = new DownloadPart("Part 2");

        t1.start();
        t2.start();

        try {
            t1.join();
            t2.join();
        } catch (Exception e) {}

        System.out.println("File download completed.");
    }
}
